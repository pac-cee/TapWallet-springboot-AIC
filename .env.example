# Copy to .env before using Docker Compose. Do not commit real secrets.
POSTGRES_DB=tapwallet
POSTGRES_USER=tapwallet
POSTGRES_PASSWORD=tapwallet_dev
MONGO_INITDB_ROOT_USERNAME=tapwallet
MONGO_INITDB_ROOT_PASSWORD=tapwallet_dev
RABBITMQ_DEFAULT_USER=tapwallet
RABBITMQ_DEFAULT_PASS=tapwallet_dev
JWT_SECRET=replace-with-at-least-32-random-characters-before-deployment
NEXT_PUBLIC_API_URL=http://localhost:8080/api
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
