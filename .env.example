# Copy to .env before using Docker Compose. Do not commit real secrets.
POSTGRES_DB=tapwallet
POSTGRES_USER=tapwallet
# Leave blank for an ephemeral local key, or set at least 32 random characters for a stable deployment.
JWT_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:8080/api
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
